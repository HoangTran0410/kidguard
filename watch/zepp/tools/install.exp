set timeout 60
cd [file dirname [file dirname [file normalize [info script]]]]
spawn zeus bridge
expect -re {bridge\$|>\s*$|\$ $}
sleep 2
send "connect\r"
expect {
  -re {Use arrow keys} { sleep 1; send "\r"; exp_continue }
  -re {(?i)success|connected} {}
  timeout { puts "\nCONNECT TIMEOUT"; exit 1 }
}
sleep 2
send "install\r"
set timeout 180
expect {
  -re {Use arrow keys} { sleep 1; send "\r"; exp_continue }
  -re {Install lite app result: success} {}
  -re {(?i)fail|error} { sleep 3 }
  timeout { puts "\nINSTALL TIMEOUT" }
}
sleep 2
send "exit\r"
expect eof
