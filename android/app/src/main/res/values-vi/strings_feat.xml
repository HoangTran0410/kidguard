    <string name="feat_owner_title">Quyền Device Owner</string>
    <string name="feat_owner_body">Device Owner cho phép khoá màn hình chính, ẩn app, chặn gỡ cài đặt và đổi DNS. Cần cài một lần bằng máy tính hoặc mã QR (xoá hết tài khoản trên máy trước). Xem hướng dẫn để biết các bước.</string>
    <string name="feat_adb_body">Máy tự chạy adb cho chính nó (Wi-Fi). Xem hướng dẫn để bật Gỡ lỗi không dây.</string>
