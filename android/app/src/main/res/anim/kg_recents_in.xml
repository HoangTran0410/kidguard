<?xml version="1.0" encoding="utf-8"?>
<!-- NavGest Recents: the Recents screen fades in from slightly larger (the app shrinking into its card, roughly) -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="260" android:interpolator="@android:interpolator/decelerate_cubic" android:zAdjustment="top">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <scale android:fromXScale="1.08" android:toXScale="1" android:fromYScale="1.08" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
</set>
