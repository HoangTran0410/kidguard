    <!-- Basic mode setup card -->
    <string name="basic_title">Quick setup, no computer needed</string>
    <string name="basic_intro">Do the steps below in order. Each button opens the right screen: turn the setting on, then press Back.</string>
    <string name="basic_admin">1. Turn on device admin</string>
    <string name="basic_admin_d">So KidGuard can lock the phone and can\'t be removed without a parent.</string>
    <string name="basic_admin_expl">KidGuard needs this to lock the screen and to stop being uninstalled.</string>
    <string name="basic_acc">2. Turn on Accessibility for KidGuard</string>
    <string name="basic_acc_d">Open Accessibility, pick KidGuard, turn it on. It blocks locked apps and keeps KidGuard from being switched off.</string>
    <string name="basic_usage">3. Allow usage access</string>
    <string name="basic_usage_d">Pick KidGuard and turn on \"Permit\". It counts the time spent in each app.</string>
    <string name="basic_loc">4. Allow location</string>
    <string name="basic_loc_d">So your parent knows where you are. Choose \"Precise\" and \"While using the app\" here.</string>
    <string name="basic_loc_bg">4. Location: choose \"Allow all the time\"</string>
    <string name="basic_loc_bg_d">So your parent can see the location even when KidGuard isn\'t open. Choose \"Allow all the time\" on the next screen.</string>
    <string name="basic_notif">5. Allow notifications</string>
    <string name="basic_notif_d">So you see reminders, and why an app is locked.</string>
    <string name="basic_battery">6. No battery limits for KidGuard</string>
    <string name="basic_battery_d">Otherwise the phone may stop KidGuard to save battery.</string>
    <string name="basic_autostart">Allow autostart (Oppo, Xiaomi, Vivo…)</string>
    <string name="basic_play_protect">Blocked by Google Play Protect (\"App blocked to protect your device\")? Open Play Store → profile picture → Play Protect → ⚙ → turn off \"Scan apps with Play Protect\", finish the steps here, then turn it back on.</string>

