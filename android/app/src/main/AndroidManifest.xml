<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- launcher: swipe down on the home pulls the notification shade (normal permission) -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- basic mode self-update: the child confirms the system install screen (Device Owner installs without it) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wi-Fi signal (RSSI) for the parent's "Máy" view on API 26-28 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- launcher control center: Wi-Fi / Bluetooth toggles (Device Owner on Android 10+ / 13+), auto-rotate + brightness
         where setup gave no WRITE_SECURE_SETTINGS (the user grants the WRITE_SETTINGS app-op) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- live screen on Android 8-10 (no accessibility screenshot): MediaProjection, the child confirms the system dialog -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- "listen around" (LAN / Tailscale): the child always gets a beep + notification, see Listen.kt -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- wrong-PIN photo (rule pinShot, Shot.kt): front camera, told on the PIN dialog -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- parent's files -> public Download/KidGuard on API 26-28 (Device Owner grants it); 29+ uses MediaStore, no permission -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- bank apps: their background process is closed when our accessibility service comes back (AccPause) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- granted by setup over adb: lets the app turn its accessibility service back on -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- basic mode: lets AccPause reopen a bank app from the background (Android blocks background activity starts
         otherwise when KidGuard is not the HOME in front). Granted by setup over adb (appops) or the Features sheet -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Control center "Không làm phiền" tile: without it the app is not listed on the system's DND access page -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- apps without a launcher icon are counted and limited too: needs to see every package -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- the launcher apps, to list and limit them (Android 11+ package visibility) -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <!-- clock / calendar widgets open the phone's clock and calendar apps -->
        <intent><action android:name="android.intent.action.SHOW_ALARMS" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_CALENDAR" /></intent>
        <package android:name="com.tailscale.ipn" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="KidGuard"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppBase">
        <!-- adb shell may sample the CPU (simpleperf) for perf work; not debuggable, nothing else exposed -->
        <profileable android:shell="true" tools:targetApi="29" />

        <activity
            android:name=".MainActivity"
            android:theme="@style/AppMain"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- long-press on our Quick Settings tiles opens this screen instead of App info (Force stop / Uninstall) -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- "KidGuard Home" in the phone's app list: opens the kid launcher directly (HomeEntry.kt) -->
        <activity
            android:name=".HomeEntry"
            android:exported="true"
            android:label="@string/home_app"
            android:icon="@mipmap/ic_home_app"
            android:roundIcon="@mipmap/ic_home_app"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- an app pins a shortcut while our launcher is the default home (only the default home's handler is used) -->
        <activity
            android:name=".PinShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
        <!-- v0.9.9 kid launcher: off until the `launcher` rule enables it (LauncherSafe, Device Owner only); release disables it -->
        <activity
            android:name=".HomeActivity"
            android:enabled="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:clearTaskOnLaunch="true"
            android:taskAffinity="dev.kidguard.home"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/AppHome">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- launcher "Tuỳ chỉnh" (long-press empty home space); same task as the home, never in recents -->
        <activity
            android:name=".CustomActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="dev.kidguard.home"
            android:screenOrientation="portrait"
            android:theme="@style/AppMain" />

        <!-- kid notification history (NotifLog), opened from the home long-press menu; same task as the home, never in recents -->
        <activity
            android:name=".NotifLogActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="dev.kidguard.home"
            android:screenOrientation="portrait"
            android:theme="@style/AppMain" />
        <activity
            android:name=".NotifStatsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="dev.kidguard.home"
            android:screenOrientation="portrait"
            android:theme="@style/AppMain" />
        <activity
            android:name=".NotifDetailActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="dev.kidguard.home"
            android:screenOrientation="portrait"
            android:theme="@style/AppMain" />

        <!-- quick actions (Quick.kt): lock only / time left only; they open nothing but KidGuard. Disabled by release. -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.NoDisplay" />

        <receiver
            android:name=".FocusEndReceiver"
            android:exported="false" />

        <receiver
            android:name=".LockReceiver"
            android:exported="false" />

        <receiver
            android:name=".LockWidget"
            android:exported="true"
            android:label="@string/q_lock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_lock" />
        </receiver>

        <receiver
            android:name=".TimeWidget"
            android:exported="true"
            android:label="@string/q_time">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_time" />
        </receiver>

        <service
            android:name=".LockTile"
            android:exported="true"
            android:icon="@drawable/li_lock"
            android:label="@string/q_lock"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".TimeTile"
            android:exported="true"
            android:icon="@drawable/li_timer"
            android:label="@string/q_time"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- QR provisioning: the setup wizard calls these (only the system may, hence BIND_DEVICE_ADMIN) -->
        <activity
            android:name=".ProvisioningModeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@style/AppClear">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PolicyComplianceActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@style/AppClear">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SelfSetupActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- on-device parent page (PIN / Authenticator); config changes must not restart it: a pause ends the session -->
        <activity
            android:theme="@style/AppWeb"
            android:name=".AdminActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale" />

        <receiver
            android:name=".TimerReceiver"
            android:exported="false" />

        <receiver
            android:name=".PairCodeReceiver"
            android:exported="false" />

        <activity
            android:name=".MessageActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true" />

        <!-- command "wake": turns the screen on over the lock screen (Wake.kt) -->
        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/AppClear" />

        <!-- live screen on Android 8-10 (Proj.kt): the system consent dialog + the service that holds the projection -->
        <activity
            android:name=".ProjActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/AppClear" />

        <service
            android:name=".ProjService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <receiver
            android:name=".RingStopReceiver"
            android:exported="false" />

        <!-- notification dots on the kid launcher's icons: counts only (NotifDots) -->
        <service
            android:name=".NotifDots"
            android:exported="true"
            android:label="KidGuard"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".Guard"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parental_controls" />
        </service>

        <receiver
            android:name=".Admin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".Boot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".Watchdog"
            android:exported="false" />

        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <service
            android:name=".Acc"
            android:exported="false"
            android:label="KidGuard"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility" />
        </service>
        <!-- shared folder (Files.kt): share target "Gửi cho bố mẹ", the sheet's file picker, opening a file the parent sent -->
        <activity
            android:name=".ShareInActivity"
            android:label="@string/files_share_label"
            android:icon="@mipmap/ic_launcher"
            android:theme="@style/AppClear"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:exported="true">
            <intent-filter android:label="@string/files_share_label">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <provider
            android:name=".FilesProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
